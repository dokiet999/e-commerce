# =============================================================
# Django eCommerce Microservices - Environment Variables
# =============================================================
# Copy this file to .env and update secret values for your local environment.

# ---- General ----
DEBUG=True
JWT_SECRET_KEY=change-me
SERVICE_AUTH_TOKEN=change-me

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# ---- MySQL ----
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---- Database Host ----
# Use localhost when running services directly.
# Use host.docker.internal when running services in Docker against local databases.
DB_HOST=host.docker.internal

# ---- Database Names ----
AUTH_DB_NAME=ecommerce_auth
PRODUCT_DB_NAME=ecommerce_products
CART_DB_NAME=ecommerce_cart
ORDER_DB_NAME=ecommerce_orders
PAYMENT_DB_NAME=ecommerce_payments
INVENTORY_DB_NAME=ecommerce_inventory
NOTIFICATION_DB_NAME=ecommerce_notifications
REVIEW_DB_NAME=ecommerce_reviews
SHIPPING_DB_NAME=ecommerce_shipping
COUPON_DB_NAME=ecommerce_coupons
AI_DB_NAME=ecommerce_ai

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Supabase Notification Storage ----
# Create table with notification_service/supabase_schema.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_ANON_KEY=change-me
SUPABASE_NOTIFICATIONS_TABLE=notifications

# ---- Service Hosts ----
# When running in Docker, use container names.
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001
PRODUCT_SERVICE_HOST=product-service
PRODUCT_SERVICE_PORT=8002
CART_SERVICE_HOST=cart-service
CART_SERVICE_PORT=8003
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8004
GATEWAY_HOST=api-gateway
GATEWAY_PORT=8000
ORDER_SERVICE_HOST=order-service
ORDER_SERVICE_PORT=8005
PAYMENT_SERVICE_HOST=payment-service
PAYMENT_SERVICE_PORT=8006
INVENTORY_SERVICE_HOST=inventory-service
INVENTORY_SERVICE_PORT=8007
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=8008
REVIEW_SERVICE_HOST=review-service
REVIEW_SERVICE_PORT=8009
SHIPPING_SERVICE_HOST=shipping-service
SHIPPING_SERVICE_PORT=8010
COUPON_SERVICE_HOST=coupon-service
COUPON_SERVICE_PORT=8011

# ---- Service URLs ----
# In Docker, services reference each other by container name.
AUTH_SERVICE_URL=http://auth-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
CART_SERVICE_URL=http://cart-service:8003
AI_SERVICE_URL=http://ai-service:8004
ORDER_SERVICE_URL=http://order-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
INVENTORY_SERVICE_URL=http://inventory-service:8007
NOTIFICATION_SERVICE_URL=http://notification-service:8008
REVIEW_SERVICE_URL=http://review-service:8009
SHIPPING_SERVICE_URL=http://shipping-service:8010
COUPON_SERVICE_URL=http://coupon-service:8011

# ---- Frontend ----
API_GATEWAY_URL=http://localhost:8000

# ---- LLM Provider ----
# Supported values: gemini, openai, ollama.
LLM_PROVIDER=gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-flash

# ---- Ollama Fallback ----
# Enable these when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct

# ---- OpenAI Fallback ----
# Enable these when LLM_PROVIDER=openai.
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
