# =============================================================
# Django eCommerce Microservices - Environment Variables
# =============================================================
# Copy to .env and update values for your local environment

# ---- General ----
DEBUG=True
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# ---- PostgreSQL (Auth + Product services) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- MySQL (Cart service) ----
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_PORT=3306

# ---- Database Host ----
# Use 'localhost' when running services directly
# Use 'host.docker.internal' when running services in Docker
DB_HOST=host.docker.internal

# ---- Database Names ----
AUTH_DB_NAME=ecommerce_auth
PRODUCT_DB_NAME=ecommerce_products
CART_DB_NAME=ecommerce_cart

# ---- Redis (Service Registry) ----
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# ---- Service Hosts (for registry) ----
# When running in Docker, use container names
AUTH_SERVICE_HOST=auth_service
AUTH_SERVICE_PORT=8001
PRODUCT_SERVICE_HOST=product_service
PRODUCT_SERVICE_PORT=8002
CART_SERVICE_HOST=cart_service
CART_SERVICE_PORT=8003
GATEWAY_HOST=api_gateway
GATEWAY_PORT=8000

# ---- Service URLs (fallback when registry is down) ----
# In Docker, services reference each other by container name
AUTH_SERVICE_URL=http://auth_service:8001
PRODUCT_SERVICE_URL=http://product_service:8002
CART_SERVICE_URL=http://cart_service:8003
